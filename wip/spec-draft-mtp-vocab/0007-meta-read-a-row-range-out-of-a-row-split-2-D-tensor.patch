From 370eeae311d6006a990c669b05b2b7b1e93f0f4d Mon Sep 17 00:00:00 2001
From: Stew Forster <ci@rdna-boosts.invalid>
Date: Wed, 21 Oct 2026 23:03:34 -0500
Subject: [PATCH 7/9] meta : read a row range out of a row-split 2-D tensor

`ggml_backend_meta_buffer_get_tensor` spliced a split tensor only in whole
`nb[axis + 1]` chunks, which for a 2-D tensor is the whole tensor: a partial
read of a vocabulary-split LM head (axis 1) asserted

    ggml-backend-meta.cpp:2319: GGML_ASSERT(size % chunk_size_full == 0) failed

so any per-row read of such a head was impossible even though each device
holds a contiguous run of rows and the MIRRORED branch next to it already
serves arbitrary ranges.

Splice a row range device by device (per segment/repeat, so a repeated
split is handled too): each device's rows are contiguous in its own simple
tensor, so a run that falls inside one device is one copy and a run that
straddles devices is one copy per device.  Whole-tensor reads and the other
split axes keep the existing paths.

Needed by --spec-draft-mtp-vocab, whose subset is copied out of the LM head:
with -sm tensor the head is vocabulary-split, and the build aborted there
(measured with Qwen3.8-27B-Q8_0 at 2 GPUs; the same config runs fine under
-sm layer, and fixed here it runs under -sm tensor).
---
 ggml/src/ggml-backend-meta.cpp | 44 ++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/ggml/src/ggml-backend-meta.cpp b/ggml/src/ggml-backend-meta.cpp
index 60e5233e8..5a80a0d79 100644
--- a/ggml/src/ggml-backend-meta.cpp
+++ b/ggml/src/ggml-backend-meta.cpp
@@ -2309,6 +2309,50 @@ static void ggml_backend_meta_get_tensor_impl(ggml_backend_t backend, ggml_backe
         return;
     }
 
+    // A 2-D tensor whose ROWS are split across the devices (axis 1 of a [n_embd, n_vocab] tensor -- e.g. a
+    // vocabulary-split LM head): each device holds a contiguous run of rows, so a row range is spliced
+    // device by device.  The chunked path below can only serve a whole-tensor read of this shape, because
+    // its chunk is `nb[axis + 1]`, which for a 2-D tensor is the whole tensor
+    // (spec-draft-mtp-vocab: the MTP draft head's row subset is copied out of exactly this shape).
+    if (split_state.axis == GGML_BACKEND_SPLIT_AXIS_1 && split_state.n_segments == 1 &&
+            tensor->ne[2] == 1 && tensor->ne[3] == 1) {
+        const size_t row_stride = tensor->nb[1];
+        GGML_ASSERT(offset % row_stride == 0);
+        GGML_ASSERT(size   % row_stride == 0);
+        GGML_ASSERT(split_state.nr[0] != 0);
+
+        int64_t rows_per_rep = 0;
+        for (size_t j = 0; j < n_bufs; j++) {
+            rows_per_rep += split_state.ne[j];
+        }
+        GGML_ASSERT(rows_per_rep > 0);
+        GGML_ASSERT(rows_per_rep * split_state.nr[0] == tensor->ne[1]);
+
+        const int64_t row_start = (int64_t) (offset / row_stride);
+        const int64_t row_end   = row_start + (int64_t) (size / row_stride);
+        GGML_ASSERT(row_end <= tensor->ne[1]);
+
+        size_t offset_data = 0;
+        for (uint32_t r = 0; r < split_state.nr[0] && offset_data < size; r++) {
+            int64_t base = (int64_t) r * rows_per_rep;
+            for (size_t j = 0; j < n_bufs; j++) {
+                const int64_t rows_j = split_state.ne[j];
+                const int64_t r0 = std::max(row_start, base);
+                const int64_t r1 = std::min(row_end,   base + rows_j);
+                if (r1 > r0) {
+                    const ggml_tensor * simple_tensor = ggml_backend_meta_buffer_simple_tensor(tensor, j);
+                    const size_t nbytes = (size_t) (r1 - r0) * row_stride;
+                    ggml_backend_meta_get_2d_any(backend, j, simple_tensor, (char *) data + offset_data,
+                        (size_t) (r0 - base) * simple_tensor->nb[1], nbytes, 1, nbytes, nbytes);
+                    offset_data += nbytes;
+                }
+                base += rows_j;
+            }
+        }
+        GGML_ASSERT(offset_data == size);
+        return;
+    }
+
     switch (split_state.axis) {
         case GGML_BACKEND_SPLIT_AXIS_0:
         case GGML_BACKEND_SPLIT_AXIS_1:
-- 
2.56.0

