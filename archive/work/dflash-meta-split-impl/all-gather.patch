+            GGML_ASSERT(ss.n_segments == 1 && ss.nr[0] == 1);
+            GGML_ASSERT(ggml_is_contiguous(src) && ggml_is_contiguous(node));
+        } else {
+            GGML_ASSERT(ss.axis == GGML_BACKEND_SPLIT_AXIS_MIRRORED);
