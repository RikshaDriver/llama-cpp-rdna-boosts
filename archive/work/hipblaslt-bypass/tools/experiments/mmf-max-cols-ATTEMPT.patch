+// wip/hipblaslt-bypass experiment knob (NOT a delivery change).
+// Upstream caps a non-quantized weight GEMM at 16 columns, which is what sends every prefill
+// f32/bf16 weight GEMM to cuBLAS -- and on ROCm, via rocBLAS, to hipBLASLt.  Raising the cap moves
+// those GEMMs onto the native MMA kernel.  16 = upstream behaviour (default); 0 = no extra cap.
+static int ggml_cuda_mmf_max_cols() {
+    static const int v = []() {
+        const char * s = getenv("GGML_CUDA_MMF_MAX_COLS");
+        return s ? atoi(s) : 16;
+    }();
+    return v;
+}
