-    if (!on) {
-        return;
-    }
-    static std::map<std::string, int> seen;
-    const std::string k = std::to_string(ne2) + "/" + (blocked ? "block" : "allow") + "/" + why;
-    if (seen.emplace(k, 1).second) {
-        GGML_LOG_WARN("FUSE_TRACE ne2=%d %s (%s)\n", ne2, blocked ? "BLOCK" : "allow", why);
-    }
