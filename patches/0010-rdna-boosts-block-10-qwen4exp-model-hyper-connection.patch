-            cgraph->nodes[i + 1]->op == GGML_OP_MUL_MAT_ID &&
-            cgraph->nodes[i + 1]->ne[2] <= MOE_EXPERT_CACHE_MAX_TOK) {
-        return true;
-    }
-
-    return false;
-}
