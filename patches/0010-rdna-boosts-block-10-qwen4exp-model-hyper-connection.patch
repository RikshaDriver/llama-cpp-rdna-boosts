+    ggml_set_op_params_i32(result, 0, (int32_t) hc);
+    ggml_set_op_params_f32(result, 1, eps);
+
+    result->op     = GGML_OP_HC_MIX;
+    result->src[0] = x;
+    result->src[1] = w_norm;
+    result->src[2] = w_down;
