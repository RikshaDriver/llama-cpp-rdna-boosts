+                        for (int j = 0; j < 8; ++j) {
+                            const int64_t e = blk*32 + 4*j; // element index within the row
+                            dequantize_kv(Kb, &K_smem[cell][blk*16 + 2*j], e);
+                            dequantize_kv(Vb, &V_smem[cell][blk*16 + 2*j], e);
+                        }
