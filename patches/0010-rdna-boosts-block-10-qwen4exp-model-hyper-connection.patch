+    GGML_ASSERT(w_down->type   == GGML_TYPE_Q8_0 || hc_bf16);
+    GGML_ASSERT(w_up->type     == w_down->type);
+    GGML_ASSERT(w_inject == NULL || (hc_bf16 ? w_inject->type == GGML_TYPE_BF16 :
+                                     (w_inject->type == GGML_TYPE_F32 || w_inject->type == GGML_TYPE_Q8_0)));
+    GGML_ASSERT(hc > 0);
